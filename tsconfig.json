{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "engine/**/*",
    "netcode/**/*",
    "gameplay/**/*",
    "rendering/**/*",
    "tools/**/*",
    "services/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
