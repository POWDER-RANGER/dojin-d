{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InputPacket",
    "description": "Per-frame player input packet for netcode synchronization",
    "type": "object",
    "properties": {
        "frame": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string" },
        "inputs": {
            "type": "object",
            "properties": {
                "moveX": { "type": "number" },
                "moveY": { "type": "number" },
                "attack": { "type": "boolean" },
                "jump": { "type": "boolean" },
                "focus": { "type": "boolean" }
            },
            "required": ["moveX", "moveY", "attack", "jump", "focus"]
        }
    },
    "required": ["frame", "playerId", "inputs"]
}
